# =====================================================================
# SmartDesk - configuration locale
#
# Le script scripts\setup.ps1 copie ce fichier en ".env" et y génère
# automatiquement des secrets aléatoires. Le fichier .env n'est JAMAIS
# commité (il est dans .gitignore).
#
# Format : CLE=valeur, sans guillemets, sans antislash (\).
# =====================================================================

# --- Base de données PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/chatbot_db
DB_USERNAME=smartdesk
DB_PASSWORD=

# --- Sécurité ---
# Clé de signature des tokens JWT (au moins 32 caractères aléatoires)
JWT_SECRET=
# Durée d'une session en millisecondes (8 h)
JWT_EXPIRATION_MS=28800000
# Clé partagée entre le backend et le service NLP (en-tête X-API-Key)
NLP_API_KEY=

# --- Compte administrateur créé au PREMIER démarrage du backend ---
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire est affiché dans la console.
# Mot de passe oublié : changez ADMIN_PASSWORD (8 caractères minimum) puis redémarrez le backend.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@fpst.tn
ADMIN_PASSWORD=

# --- Port du backend (le frontend y relaie /api) ---
SERVER_PORT=8095

# --- Service NLP / IA ---
NLP_URL=http://localhost:8000
# Clé Groq (gratuite) : https://console.groq.com/keys
GROQ_API_KEY=

# --- Origines autorisées pour le frontend (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:61748

# --- Dossier des documents générés (relatif au dossier backend) ---
DOCUMENTS_DIR=./documents

# --- Docker (scripts/docker-demarrer) ---
# Port du site quand SmartDesk tourne dans Docker : http://localhost:8090
APP_PORT=8090

# --- Données de démonstration ---
# true : au démarrage, le backend remplit la base avec des données FICTIVES
# (filières, matières, salles, registre, comptes étudiants et professeurs,
# emplois du temps, notes, présences, notifications). Rien n'est dupliqué
# ni écrasé d'un démarrage à l'autre. Mettez false sur un serveur réel.
DEMO_DATA=true
# Mot de passe commun des comptes de démonstration (identifiant : prenom.nom)
DEMO_PASSWORD=Demo2026

# --- Registre de l'établissement (vérification des inscriptions par CIN) ---
# local   : registre importé par l'admin (Excel/CSV) ou données de démonstration
# externe : base de données de la faculté, en lecture seule (voir README)
REGISTRE_MODE=local
REGISTRE_DB_URL=
REGISTRE_DB_USERNAME=
REGISTRE_DB_PASSWORD=
REGISTRE_DB_REQUETE=

# --- Pointage RFID des professeurs ---
# Clé partagée avec le programme de pointage (scripts\pointage.cmd)
RFID_DEVICE_KEY=
# Port série de l'Arduino (vide = détection automatique, ex : COM3)
RFID_PORT=
BACKEND_URL=http://localhost:8095
